{
  "name": "@rivium/flags-node",
  "version": "0.2.0",
  "description": "Rivium Flags server SDK for Node.js - local flag evaluation with targeting rules, rollouts and variants",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "feature-flags",
    "rivium",
    "feature-toggle",
    "nodejs"
  ],
  "author": "Rivium",
  "license": "MIT",
  "homepage": "https://rivium.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rivium-co/rivium-flags-nodejs-sdk"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
